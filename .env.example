# ==============================================================================
# AI Data Contract & Schema Drift Monitor - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Security & Access Control
# PUBLIC_ACCESS_ENABLE controls whether unauthenticated public users can inspect
# public contracts, drift reports, and run sample demo simulations in read-only mode.
# When true: public read-only viewer mode is permitted; destructive actions,
# contract publishing, approvals, and mutations strictly require authentication.
# When false: all endpoints require Bearer JWT or service API key.
# Accepted values: "true" | "false" (default: "false")
# ------------------------------------------------------------------------------
PUBLIC_ACCESS_ENABLE=false
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
OPERATOR_ADMIN_PASSWORD=change-me-in-production-strong-password
SERVICE_API_KEY=replace-with-service-to-service-api-key

# ------------------------------------------------------------------------------
# Persistence & Database Strategy
# If MONGODB_URI is provided, persistent storage in MongoDB is used.
# If omitted or unavailable, the backend gracefully utilizes the in-memory
# repository with atomic collection maps for local dev, testing, and CI.
# Never rely on ephemeral local files for durable contracts or audit records.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/data_contract_monitor?authSource=admin

# ------------------------------------------------------------------------------
# Redis Cache & Deduplication (Optional Railway Shared Service)
# Used for schema snapshot deduplication, query caching, and rate limiting.
# If omitted or unreachable, backend falls back to in-memory TTL caching.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Shared AI Platform (Railway Shared Service)
# Verified endpoint: POST /api/v1/ai/chat
# Headers: x-api-key: <AI_PLATFORM_API_KEY>
# Payload: { applicationId, tenantId, message, systemInstruction }
# If unreachable or omitted, the application uses its built-in deterministic
# schema migration and drift impact synthesis engine.
# ------------------------------------------------------------------------------
AI_PLATFORM_URL=https://ai-platform.onrender.com
AI_PLATFORM_API_KEY=replace-with-ai-platform-service-key

# ------------------------------------------------------------------------------
# Notification Service (Railway Shared Service)
# Verified endpoint: POST /v1/notifications
# Headers: x-api-key: <NOTIFICATION_SERVICE_API_KEY>
# Used for dispatching alerts upon breaking schema drift detection or approval requests.
# If omitted or unreachable, backend logs notifications safely to the audit log.
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_URL=https://notification-service.onrender.com
NOTIFICATION_SERVICE_API_KEY=replace-with-notification-service-key
ALERT_EMAIL_RECIPIENT=data-platform-oncall@company.internal

# ------------------------------------------------------------------------------
# Frontend Configuration (Used by Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="AI Data Contract & Schema Drift Monitor"
NEXT_PUBLIC_DEFAULT_PUBLIC_ACCESS=false
